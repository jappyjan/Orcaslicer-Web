{
  "name": "orcaslicer-web",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable, mobile-first web frontend that slices 3D models with the upstream OrcaSlicer CLI",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build tsconfig.json && npm run typecheck -w @orca-web/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project web",
    "test:watch": "vitest --project unit --project web",
    "smoke": "docker compose run --rm smoke",
    "help-check": "docker compose run --rm help-check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test:integration": "docker compose run --rm integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
